<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<AnchorPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="project.ui.MainMenuController"
            stylesheets="@styles.css">
    <children>
        <!-- Заголовок -->
        <Label text="Maze Game"
               layoutX="275" layoutY="50"
        styleClass="title-label" />

        <!-- Кнопка Host Game -->
        <Button fx:id="hostButton"
                text="Host Game"
                layoutX="275" layoutY="150"
        />

        <!-- Кнопка Join Game -->
        <Button fx:id="joinButton"
                text="Join Game"
                layoutX="275" layoutY="240"
        />
    </children>
</AnchorPane>
